# ===== 应用 =====
APP_NAME=基于AIoT的居家养老健康平台
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== 数据库 =====
# 默认 SQLite: 零依赖, 不需要 Docker
DATABASE_URL=sqlite+aiosqlite:///./aiot_elder.db
# 启用 docker-compose 后改用 PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://aiot:aiot123456@localhost:5432/aiot_elder

# ===== Redis(可选) =====
# 连不上会自动退化为进程内缓存, 功能不受影响
REDIS_URL=redis://localhost:6379/0

# ===== MQTT =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=aiot-backend
MQTT_TOPIC_PREFIX=aiot

# ===== AI 能力 =====
# provider 可选: mock / openai / dashscope
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

ASR_PROVIDER=mock
ASR_API_KEY=
ASR_MODEL=paraformer-realtime-v2

TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=cosyvoice-v1

# ===== 天气 =====
# provider 可选: mock(内置模拟) / qweather(和风天气) / open-meteo(免密钥)
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
# 实时天气缓存时长, 直接决定和风天气的调用量
WEATHER_CACHE_SECONDS=600
DEFAULT_CITY=杭州

# 和风天气: API Host 在控制台-设置中查看, 形如 abcxyz.qweatherapi.com
QWEATHER_API_HOST=
# 控制台-项目管理里创建的 API KEY 凭据
QWEATHER_API_KEY=
# 关掉则不再请求空气质量接口, 规则引擎中的 AQI 判定随之跳过
QWEATHER_AIR_QUALITY=true

# ===== 后台巡检任务 =====
SCHEDULER_INTERVAL_SECONDS=15
DEVICE_OFFLINE_SECONDS=90
